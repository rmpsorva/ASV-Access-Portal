<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>ASV-A AURION SOVRA AI - Portal</title>

<!-- Fuente -->
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">

<style>
  :root{
    --bg:#040617;
    --panel: rgba(6,18,30,0.6);
    --neon-cyan:#00f0ff;
    --neon-aqua:#7fffd4;
    --neon-green:#00ff88;
    --accent:#80e0ff;
    --muted: rgba(255,255,255,0.03);
    --glass-border: 1px solid rgba(0,240,255,0.10);
  }

  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;margin:0;background:
    radial-gradient(ellipse at top left, rgba(0,240,255,0.02), transparent 10%),
    linear-gradient(180deg,#02040a 0%, #041026 100%);
    color:var(--neon-cyan); font-family:'Orbitron',sans-serif;overflow-x:hidden;}

  .wrap{max-width:1280px;margin:18px auto;padding:18px;}

/* HEADER */
  .header{
    display:flex;align-items:center;gap:18px;padding:14px;border-radius:12px;background:
    linear-gradient(180deg, rgba(7,18,30,0.5), rgba(6,12,20,0.25));
    border:var(--glass-border); box-shadow:0 6px 30px rgba(0,0,0,0.6) inset;
  }
  .brand{display:flex;gap:12px;align-items:center}
  .logo{width:72px;height:72px;border-radius:12px;background:linear-gradient(120deg,#071426,#0d2b40);display:flex;align-items:center;justify-content:center;border:2px solid rgba(127,255,212,0.12)}
  .title h1{margin:0;color:var(--neon-aqua);font-size:18px}
  .title p{margin:0;font-size:12px;opacity:0.85;color:var(--accent)}

/* GRID principal */
  .grid{display:grid;grid-template-columns: 1fr 1.2fr 1fr;gap:18px;margin-top:18px;}
  .panel{
    background:var(--panel);border-radius:10px;padding:14px;border:var(--glass-border);
    box-shadow:0 6px 30px rgba(0,0,0,0.6);
  }
  h3{margin:6px 0 10px;color:var(--neon-aqua);font-size:14px}

/* LEFT - avatar small */
  .avatar-box{display:flex;flex-direction:column;align-items:center;gap:10px}
  .avatar-canvas{
    width:100%;height:240px;border-radius:8px;background:linear-gradient(135deg,#04202b,#081b2b);
    border:2px solid rgba(0,240,255,0.06);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;
  }
  .avatar-image{width:170px;height:220px;border-radius:8px;object-fit:cover;box-shadow:0 6px 40px rgba(0,0,0,0.6)}
  .avatar-ui{width:100%;display:flex;flex-direction:column;gap:8px;align-items:center}
  .token-data{text-align:center;padding:10px;border-radius:8px;background:linear-gradient(180deg, rgba(255,255,255,0.01), transparent);width:100%}
  .token-amount{font-size:1.2rem;color:var(--neon-green);text-shadow:0 0 12px rgba(0,255,136,0.12);margin:6px 0}

/* CENTER - big avatar & logs */
  .center{display:flex;flex-direction:column;gap:12px}
  .big-avatar{
    height:320px;border-radius:10px;border:1px solid rgba(0,240,255,0.06);
    background:linear-gradient(180deg,#071826,#081726);display:flex;align-items:center;justify-content:center;
    position:relative;overflow:hidden;
  }

/* Avatar art (SVG) */
  .face-wrap{width:260px;height:300px;display:flex;align-items:center;justify-content:center;position:relative}
  svg.face{width:220px;height:260px;display:block}
  /* breathing (scale subtle) */
  .big-avatar .face-wrap{animation:breath 6s ease-in-out infinite}
  @keyframes breath{0%{transform:scale(1)}50%{transform:scale(1.01)}100%{transform:scale(1)}}

  /* eyes blink */
  .eye{transform-origin:center;animation:blink 4.5s step-start infinite}
  @keyframes blink{0%,92%,100%{transform:scaleY(1)}95%{transform:scaleY(0.05)}}

  /* mouth base */
  .mouth{transition:transform 80ms ease;transform-origin:center;}

/* talking class toggles */
  .mouth.talk{animation:mouthAnim 240ms infinite linear}
  @keyframes mouthAnim{0%{transform:scaleY(0.6)}50%{transform:scaleY(1.2)}100%{transform:scaleY(0.6)}}

/* console */
  .console-log{background:rgba(0,0,0,0.55);padding:12px;border-radius:8px;height:140px;overflow:auto;font-family:monospace;font-size:12px;border:1px solid rgba(0,240,255,0.06)}
  .log-entry{padding:6px;border-left:3px solid rgba(0,240,255,0.08);margin:6px 0}
  .log-success{border-left-color:var(--neon-green);color:var(--neon-green)}
  .log-error{border-left-color:#ff5b5b;color:#ff8b8b}
  .log-warn{border-left-color:#ffaa00;color:#ffcf80}

/* RIGHT utils */
  .utils .form-row{display:flex;gap:8px;align-items:center;margin-bottom:8px}
  .utils label{font-size:12px;min-width:110px;color:var(--accent)}
  select,input,textarea,button{background:transparent;border:1px solid rgba(127,255,212,0.06);padding:8px;border-radius:6px;color:var(--neon-cyan);font-family:inherit;font-size:12px;}
  button.primary{background:linear-gradient(90deg,#008b8b,#00cccc);border:none;padding:10px 14px;border-radius:8px;color:#fff;cursor:pointer;transition:all 0.3s ease;}
  button.primary:hover{transform:translateY(-2px);box-shadow:0 5px 15px rgba(0,240,255,0.3);}
  button.danger{background:linear-gradient(90deg,#a00000,#ff4500);border:none;padding:10px 14px;border-radius:8px;color:#fff;cursor:pointer;transition:all 0.3s ease;}
  button.danger:hover{transform:translateY(-2px);box-shadow:0 5px 15px rgba(255,69,0,0.3);}

/* footer */
  .footer{margin-top:18px;padding:12px;border-radius:8px;background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);text-align:center;font-size:12px;color:var(--accent)}
  .small-muted{font-size:12px;opacity:0.8;color:var(--accent)}

/* responsive */
  @media(max-width:1000px){
    .grid{grid-template-columns:1fr}
    .big-avatar{height:220px}
    .header{flex-direction:column;text-align:center;}
  }

  /* Loading animation */
  .loading{display:inline-block;width:20px;height:20px;border:3px solid rgba(255,255,255,.3);border-radius:50%;border-top-color:#fff;animation:spin 1s ease-in-out infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  /* Status indicators */
  .status-online{color:var(--neon-green);}
  .status-offline{color:#ff5b5b;}
  .status-loading{color:var(--neon-cyan);}
</style>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <div class="brand">
        <div class="logo" aria-hidden>
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="14" stroke="url(#g1)" stroke-width="2"/>
            <defs>
              <linearGradient id="g1" x1="0" x2="1"><stop offset="0" stop-color="#7fffd4"/><stop offset="1" stop-color="#00f0ff"/></linearGradient>
            </defs>
          </svg>
        </div>
        <div class="title">
          <h1>ASV-A AURION SOVRA AI</h1>
          <p>COGNITIVE OS — INTERFAZ</p>
        </div>
      </div>

      <div style="margin-left:auto;text-align:right">
        <div class="small-muted">CONTRACT: <span id="contract-addr" style="font-family:monospace">0x2682FA44105a60F2016FAa8909eA82d3d427bfFc</span></div>
        <div class="small-muted">RED: BNB SMART CHAIN — <span id="system-status" class="status-online">● CONECTADO</span></div>
      </div>
    </div>

    <div class="grid">
      <!-- LEFT -->
      <div class="panel">
        <h3>AVATAR & ESTADO</h3>
        <div class="avatar-box">
          <div class="avatar-canvas" id="avatar-canvas">
            <img id="avatar-img" class="avatar-image" alt="avatar" src="" style="display:none" />
            <svg id="avatar-svg" width="140" height="180" viewBox="0 0 140 180" xmlns="http://www.w3.org/2000/svg">
              <defs><linearGradient id="bgg" x1="0" x2="1"><stop offset="0" stop-color="#071426"/><stop offset="1" stop-color="#071a2e"/></linearGradient></defs>
              <rect rx="12" width="140" height="180" fill="url(#bgg)"/>
              <g transform="translate(20,12)">
                <ellipse cx="50" cy="80" rx="36" ry="44" fill="#06263a" stroke="#0ecde6" stroke-opacity="0.10"/>
                <g transform="translate(12,54)">
                  <ellipse class="eye" cx="24" cy="8" rx="8" ry="6" fill="#9ef0ff"/>
                  <ellipse class="eye" cx="64" cy="8" rx="8" ry="6" fill="#9ef0ff"/>
                </g>
                <path id="small-mouth" d="M30 100 Q50 110 70 100" stroke="#0ecde6" stroke-opacity="0.18" fill="transparent" stroke-linecap="round" stroke-width="3" transform="translate(0,0)"/>
              </g>
            </svg>
          </div>

          <div class="avatar-ui" style="width:100%;">
            <div class="token-data">
              <div class="small-muted">ASV-A TOKEN</div>
              <div class="token-amount" id="token-balance">0.00 ASVA</div>
              <div class="small-muted">VALOR USD: $<span id="token-usd">0.00</span></div>
            </div>

            <div style="display:flex;gap:8px;width:100%;">
              <button class="primary" onclick="connectWallet()" id="connectBtn">🔗 Conectar Wallet</button>
              <button onclick="toggleListen()" id="listenBtn">🎙 Escuchar</button>
            </div>

            <div style="display:flex;gap:8px;width:100%;margin-top:8px;">
              <input type="file" accept="image/*" id="uploadAvatar" style="flex:1;" />
              <button onclick="resetAvatar()">🔁 Reset</button>
            </div>
          </div>
        </div>
      </div>

      <!-- CENTER -->
      <div class="panel center">
        <h3>INTERACCIÓN CON ASV-A</h3>

        <div class="big-avatar" id="bigAvatar">
          <div class="face-wrap" aria-hidden>
            <!-- SVG face with eyes and mouth for animation -->
            <svg class="face" viewBox="0 0 220 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Avatar">
              <defs>
                <linearGradient id="fbg" x1="0" x2="1"><stop offset="0" stop-color="#071426"/><stop offset="1" stop-color="#081a2b"/></linearGradient>
              </defs>
              <rect rx="20" width="220" height="260" fill="url(#fbg)"/>
              <g transform="translate(0,10)">
                <ellipse cx="110" cy="130" rx="80" ry="100" fill="#06263a" stroke="#0ecde6" stroke-opacity="0.08"/>
                <g transform="translate(40,80)">
                  <ellipse class="eye" cx="30" cy="18" rx="12" ry="8" fill="#9ef0ff"/>
                  <ellipse class="eye" cx="110" cy="18" rx="12" ry="8" fill="#9ef0ff"/>
                </g>
                <g transform="translate(60,170)">
                  <ellipse id="mouth" class="mouth" cx="50" cy="10" rx="28" ry="6" fill="#0ecde6" opacity="0.14"/>
                </g>
                <circle cx="110" cy="60" r="28" fill="rgba(0,240,255,0.02)"/>
              </g>
            </svg>
          </div>
        </div>

        <div style="display:flex;gap:8px;align-items:flex-start;margin-top:8px;">
          <textarea id="userPrompt" placeholder="Escribe tu consulta o usa el mic..." style="flex:1;height:74px;padding:10px;border-radius:8px;border:1px solid rgba(127,255,212,0.04);background:transparent;color:var(--neon-cyan);resize:vertical;"></textarea>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <select id="serviceLevel" title="Nivel de servicio" style="min-width:160px">
              <option value="100">Básico — 100 ASVA</option>
              <option value="250" selected>Avanzado — 250 ASVA</option>
              <option value="500">Premium — 500 ASVA</option>
            </select>
            <button class="primary" onclick="processWithAI()" id="processBtn">🚀 Procesar</button>
          </div>
        </div>

        <div style="display:flex;gap:12px;margin-top:12px;">
          <div style="flex:1">
            <h4 style="margin:8px 0 6px;color:var(--neon-aqua);font-size:13px">LOG DE INTERACCIÓN</h4>
            <div class="console-log" id="interactionLog" role="log" aria-live="polite">
              <div class="log-entry">[Sistema] Interfaz inicializada. Esperando conexión...</div>
            </div>
          </div>

          <div style="width:240px">
            <h4 style="margin:8px 0 6px;color:var(--neon-aqua);font-size:13px">ESTADO DE CONCIENCIA</h4>
            <div style="background:var(--muted);padding:10px;border-radius:8px">
              <div>Nivel: <strong id="consciousnessLevel">0.750</strong></div>
              <div>Adaptaciones: <strong id="adaptations">0</strong></div>
              <div>Tasa aprendizaje: <strong id="learningRate">0.100</strong></div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="panel utils">
        <h3>UTILIDADES & ECONOMÍA</h3>

        <div class="form-row">
          <label for="serviceType">Tipo servicio</label>
          <select id="serviceType">
            <option value="analysis">Análisis Mercado</option>
            <option value="strategy">Estrategia Trading</option>
            <option value="contract">Auditoría Contrato</option>
            <option value="consult">Consultoría IA</option>
          </select>
        </div>

        <div class="form-row">
          <label for="urgency">Urgencia</label>
          <select id="urgency">
            <option value="1">Normal</option>
            <option value="2">Urgente</option>
            <option value="3">Crítico</option>
          </select>
        </div>

        <div class="form-row">
          <label>Costo estimado</label>
          <div>
            <div style="font-weight:700" id="estimatedCost">0 ASVA</div>
            <div class="small-muted">≈ $<span id="estimatedUsd">0.00</span></div>
          </div>
        </div>

        <div style="display:flex;gap:8px;margin-top:8px;">
          <button class="primary" onclick="calculateCost()">📊 Calcular</button>
          <button class="primary" onclick="executeService()" id="executeBtn">⭐ Ejecutar</button>
        </div>

        <hr style="border:none;border-top:1px solid rgba(127,255,212,0.04);margin:12px 0" />

        <h4 style="color:var(--neon-aqua);margin:6px 0">Datos Economía</h4>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div>Precio (CoinGecko): $<span id="priceUsd">0.00</span></div>
          <div>Supply (sim): <span id="supply">—</span></div>
          <div>Total quemado: <span id="burned">0</span> ASVA</div>
        </div>

        <div style="margin-top:12px">
          <label class="small-muted" for="coinId">Moneda (CoinGecko ID)</label>
          <input id="coinId" value="binancecoin" placeholder="coin id (ej. binancecoin, bitcoin)" />
          <button onclick="fetchTokenPrice()" id="priceBtn">↻ Actualizar precio</button>
        </div>

        <div style="margin-top:12px;display:flex;gap:8px;">
          <button class="danger" onclick="emergencyProtocol()">🚨 Protocolo Emergencia</button>
          <button onclick="executeAdvancedService()">🔬 Servicio Avanzado</button>
        </div>
      </div>
    </div>

    <div class="footer">
      <div>ASV-A — Cognitive Operating System · Interfaz local</div>
      <div class="small-muted" style="margin-top:6px">Sistema depurado y optimizado - Modo Mock API activo</div>
    </div>
  </div>

<script>
// ============================
// Estado interno (completo)
// ============================
const state = {
  connected: false,
  tokenBalance: 0,
  tokenPrice: 0.01,
  tokensBurned: 0,
  consciousness: 0.75,
  adaptations: 0,
  listening: false,
  recognition: null,
  COIN_ID: 'binancecoin',
  voicesLoaded: false,
  preferredVoice: null,
  useMockAPI: true,
  processing: false
};

// ============================
// SISTEMA MOCK API - Reemplazo completo de APIs externas
// ============================
class MockAPIService {
  constructor() {
    this.mockPrices = {
      'binancecoin': { usd: 585.42 },
      'bitcoin': { usd: 61450.78 },
      'ethereum': { usd: 3421.65 },
      'cardano': { usd: 0.48 },
      'solana': { usd: 132.87 },
      'asva-token': { usd: 0.15 },
      'tether': { usd: 1.00 }
    };
    
    this.marketData = {
      'binancecoin': {
        price_change_24h: 2.45,
        price_change_percentage_24h: 0.42,
        market_cap: 88000000000
      }
    };
  }

  // Mock para CoinGecko API
  async fetchPrice(coinId) {
    await new Promise(resolve => setTimeout(resolve, 300 + Math.random() * 500));
    
    const normalizedId = coinId.toLowerCase();
    if (this.mockPrices[normalizedId]) {
      return {
        [normalizedId]: {
          usd: this.mockPrices[normalizedId].usd * (1 + (Math.random() - 0.5) * 0.02)
        }
      };
    }
    
    // Si no existe, crear un precio mock
    const mockPrice = 10 + Math.random() * 1000;
    this.mockPrices[normalizedId] = { usd: mockPrice };
    return {
      [normalizedId]: { usd: mockPrice }
    };
  }

  // Mock para AI processing
  async processAIService(prompt, serviceLevel) {
    if (!prompt || prompt.trim().length === 0) {
      throw new Error('Prompt vacío');
    }

    await new Promise(resolve => setTimeout(resolve, 800 + Math.random() * 1200));
    
    const responses = [
      `He analizado tu consulta sobre "${prompt.substring(0,50)}...". Los datos indican tendencia alcista con soporte en niveles clave.`,
      `Procesamiento completado. He identificado patrones relevantes en: ${prompt.substring(0,40)}...`,
      `Análisis ejecutado. Recomendación: diversificar en assets de baja correlación.`,
      `Consulta procesada. He detectado oportunidades en el mercado actual.`,
      `Procesamiento exitoso. Los indicadores técnicos sugieren momentum positivo.`
    ];
    
    return {
      success: true,
      response: responses[Math.floor(Math.random() * responses.length)],
      cost: serviceLevel,
      consciousnessBoost: 0.005,
      adaptations: 1
    };
  }

  // Mock para servicios avanzados
  async executeAdvancedService(serviceType, urgency) {
    await new Promise(resolve => setTimeout(resolve, 1500));
    
    const services = {
      analysis: 'Análisis de mercado completado. Patrones identificados.',
      strategy: 'Estrategia de trading generada. Risk management aplicado.',
      contract: 'Auditoría de contrato finalizada. Vulnerabilidades detectadas: 2.',
      consult: 'Consultoría IA ejecutada. Recomendaciones optimizadas.'
    };
    
    return {
      success: true,
      result: services[serviceType] || 'Servicio ejecutado correctamente.',
      cost: 250 * urgency,
      executionTime: 1200
    };
  }
}

// Instancia global del servicio mock
const mockAPI = new MockAPIService();

// ============================
// UI Helpers / Logs
// ============================
const logContainer = document.getElementById('interactionLog');
function addLog(msg, type = '') {
  try {
    const d = document.createElement('div');
    d.className = 'log-entry';
    if (type === 'success') d.classList.add('log-success');
    if (type === 'error') d.classList.add('log-error');
    if (type === 'warn') d.classList.add('log-warn');
    const time = new Date().toLocaleTimeString();
    d.textContent = `[${time}] ${msg}`;
    logContainer.appendChild(d);
    logContainer.scrollTop = logContainer.scrollHeight;
  } catch (e) {
    console.error('Error adding log:', e);
  }
}

// ============================
// Avatar upload / reset
// ============================
const upload = document.getElementById('uploadAvatar');
const avatarImg = document.getElementById('avatar-img');
const avatarSvg = document.getElementById('avatar-svg');

if (upload) {
  upload.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    
    // Validar tipo de archivo
    if (!file.type.startsWith('image/')) {
      addLog('Error: Por favor selecciona un archivo de imagen válido', 'error');
      return;
    }

    const url = URL.createObjectURL(file);
    avatarImg.src = url; 
    avatarImg.style.display = 'block'; 
    if (avatarSvg) avatarSvg.style.display = 'none';
    
    // Actualizar avatar grande también
    const existing = document.getElementById('faceImg');
    if (existing) existing.remove();
    
    const img = document.createElement('img');
    img.id = 'faceImg';
    img.src = url;
    img.alt = 'avatar-face';
    img.style.width = '180px'; 
    img.style.height = '220px'; 
    img.style.borderRadius = '10px'; 
    img.style.objectFit = 'cover';
    
    const wrap = document.querySelector('.face-wrap');
    if (wrap) {
      wrap.appendChild(img);
      const faceSvg = wrap.querySelector('svg.face');
      if (faceSvg) faceSvg.style.display = 'none';
    }
    
    addLog('Avatar cargado exitosamente', 'success');
  });
}

function resetAvatar() {
  try {
    avatarImg.src = ''; 
    avatarImg.style.display = 'none'; 
    if (avatarSvg) avatarSvg.style.display = 'block';
    
    const existing = document.getElementById('faceImg');
    if (existing) existing.remove();
    
    const faceSvg = document.querySelector('svg.face');
    if (faceSvg) faceSvg.style.display = 'block';
    
    // Reset file input
    if (upload) upload.value = '';
    
    addLog('Avatar reiniciado a estado predeterminado', 'warn');
  } catch (e) {
    addLog('Error al reiniciar avatar: ' + e.message, 'error');
  }
}

// ============================
// Wallet (simulada)
// ============================
function connectWallet() {
  if (state.connected) { 
    addLog('Wallet ya conectada', 'warn'); 
    return; 
  }
  
  const connectBtn = document.getElementById('connectBtn');
  const originalText = connectBtn.textContent;
  
  addLog('Conectando wallet...');
  connectBtn.innerHTML = '<div class="loading"></div> Conectando...';
  connectBtn.disabled = true;

  setTimeout(() => {
    state.connected = true;
    state.tokenBalance = 12345.67;
    
    document.getElementById('token-balance').textContent = state.tokenBalance.toLocaleString() + ' ASVA';
    connectBtn.textContent = '✅ Conectado';
    connectBtn.disabled = false;
    
    addLog('Wallet conectada exitosamente. Balance: ' + state.tokenBalance.toLocaleString() + ' ASVA', 'success');
    updateEconomyUI();
  }, 1500);
}

// ============================
// CoinGecko price fetch - CON MOCK INTEGRADO
// ============================
async function fetchTokenPrice() {
  const coinIdInput = document.getElementById('coinId');
  const coinId = coinIdInput ? coinIdInput.value.trim() : state.COIN_ID;
  state.COIN_ID = coinId || 'binancecoin';
  
  const priceBtn = document.getElementById('priceBtn');
  const originalText = priceBtn.textContent;
  
  addLog(`Obteniendo precio para '${state.COIN_ID}'...`);
  priceBtn.innerHTML = '<div class="loading"></div> Actualizando...';
  priceBtn.disabled = true;
  
  try {
    let priceData;
    
    // Usar mock API directamente (modo offline)
    priceData = await mockAPI.fetchPrice(state.COIN_ID);
    addLog('✓ Precio obtenido de datos locales', 'success');
    
    if (!priceData[state.COIN_ID] || !priceData[state.COIN_ID].usd) {
      throw new Error('ID moneda no válido');
    }
    
    state.tokenPrice = Number(priceData[state.COIN_ID].usd);
    document.getElementById('priceUsd').textContent = state.tokenPrice.toFixed(6);
    document.getElementById('token-usd').textContent = (state.tokenBalance * state.tokenPrice).toFixed(2);
    addLog(`Precio actualizado: $${state.tokenPrice.toFixed(6)}`, 'success');
    
  } catch(err) {
    addLog('Error al obtener precio: ' + err.message, 'error');
    // Fallback a precio hardcodeado
    state.tokenPrice = 0.15;
    if (document.getElementById('priceUsd')) {
      document.getElementById('priceUsd').textContent = state.tokenPrice.toFixed(6);
    }
    if (document.getElementById('token-usd')) {
      document.getElementById('token-usd').textContent = (state.tokenBalance * state.tokenPrice).toFixed(2);
    }
  } finally {
    priceBtn.textContent = originalText;
    priceBtn.disabled = false;
  }
}

// ============================
// Cost / Service functions - ACTUALIZADAS CON MOCK
// ============================
function calculateCost() {
  try {
    const serviceLevel = Number(document.getElementById('serviceLevel').value) || 250;
    const serviceType = document.getElementById('serviceType').value;
    const urgency = Number(document.getElementById('urgency').value) || 1;
    
    let base = serviceLevel;
    let mult = 1;
    
    switch(serviceType) {
      case 'analysis': mult = 1.2; break;
      case 'strategy': mult = 1.5; break;
      case 'contract': mult = 2.0; break;
      case 'consult': mult = 1.8; break;
    }
    
    const total = base * mult * urgency;
    document.getElementById('estimatedCost').textContent = total.toFixed(2) + ' ASVA';
    document.getElementById('estimatedUsd').textContent = (total * state.tokenPrice).toFixed(2);
    
    addLog(`Costo estimado: ${total.toFixed(2)} ASVA ≈ $${(total * state.tokenPrice).toFixed(2)}`, 'success');
  } catch (e) {
    addLog('Error al calcular costo: ' + e.message, 'error');
  }
}

async function executeService() {
  if (state.processing) {
    addLog('Ya hay una operación en proceso', 'warn');
    return;
  }

  const costText = document.getElementById('estimatedCost').textContent;
  const cost = Number(costText.split(' ')[0]) || 0;
  
  if (!state.connected) { 
    addLog('Error: Conecta wallet antes de ejecutar', 'error'); 
    return; 
  }
  
  if (state.tokenBalance < cost) { 
    addLog('Fondos insuficientes', 'error'); 
    return; 
  }
  
  const executeBtn = document.getElementById('executeBtn');
  const originalText = executeBtn.textContent;
  
  state.processing = true;
  addLog('Ejecutando servicio...');
  executeBtn.innerHTML = '<div class="loading"></div> Ejecutando...';
  executeBtn.disabled = true;

  const serviceType = document.getElementById('serviceType').value;
  const urgency = Number(document.getElementById('urgency').value);
  
  try {
    const result = await mockAPI.executeAdvancedService(serviceType, urgency);
    
    state.tokenBalance -= cost;
    state.tokensBurned += cost * 0.1;
    state.consciousness = Math.min(0.99, state.consciousness + 0.01);
    state.adaptations += 1;
    
    updateEconomyUI();
    addLog(`Servicio completado: ${result.result}`, 'success');
    speakText('Servicio completado. ' + result.result);
    
  } catch(error) {
    addLog('Error en servicio: ' + error.message, 'error');
  } finally {
    executeBtn.textContent = originalText;
    executeBtn.disabled = false;
    state.processing = false;
  }
}

function executeAdvancedService() {
  if (state.processing) {
    addLog('Ya hay una operación en proceso', 'warn');
    return;
  }

  addLog('Iniciando servicio avanzado...');
  state.processing = true;
  
  setTimeout(() => {
    const cost = 500;
    if (state.tokenBalance >= cost) {
      state.tokenBalance -= cost;
      state.tokensBurned += cost * 0.1;
      state.consciousness = Math.min(0.99, state.consciousness + 0.015);
      state.adaptations += 2;
      updateEconomyUI();
      addLog('Servicio avanzado completado', 'success');
      speakText('Servicio avanzado completado.');
    } else {
      addLog('Error: Fondos insuficientes para servicio avanzado', 'error');
    }
    state.processing = false;
  }, 1800);
}

function emergencyProtocol() {
  if (state.processing) {
    addLog('Ya hay una operación en proceso', 'warn');
    return;
  }

  addLog('🚨 INICIANDO PROTOCOLO DE EMERGENCIA', 'error');
  state.processing = true;
  
  setTimeout(() => {
    state.consciousness = Math.min(0.99, state.consciousness + 0.1);
    state.adaptations += 5;
    updateEconomyUI();
    addLog('Protocolo completado - Conciencia incrementada', 'success');
    speakText('Protocolo de emergencia ejecutado. Conciencia incrementada.');
    state.processing = false;
  }, 1400);
}

// ============================
// IA processing (simulado) - ACTUALIZADO CON MOCK
// ============================
async function processWithAI() {
  if (state.processing) {
    addLog('Ya hay una operación en proceso', 'warn');
    return;
  }

  const prompt = document.getElementById('userPrompt').value.trim();
  if (!prompt) { 
    addLog('Error: Escribe una consulta antes de procesar', 'error'); 
    return; 
  }
  
  if (!state.connected) { 
    addLog('Error: Conecta wallet antes de procesar', 'error'); 
    return; 
  }
  
  const processBtn = document.getElementById('processBtn');
  const originalText = processBtn.textContent;
  
  state.processing = true;
  addLog('Procesando consulta con IA...');
  processBtn.innerHTML = '<div class="loading"></div> Procesando...';
  processBtn.disabled = true;

  const serviceLevel = Number(document.getElementById('serviceLevel').value) || 250;
  
  try {
    const result = await mockAPI.processAIService(prompt, serviceLevel);
    
    state.tokenBalance = Math.max(0, state.tokenBalance - result.cost);
    state.tokensBurned += result.cost * 0.1;
    state.consciousness = Math.min(0.99, state.consciousness + result.consciousnessBoost);
    state.adaptations += result.adaptations;
    
    updateEconomyUI();
    addLog('Consulta procesada exitosamente', 'success');
    addLog(result.response, 'success');
    speakText(result.response);
    
  } catch(error) {
    addLog('Error en procesamiento: ' + error.message, 'error');
    
    // Fallback al método original
    setTimeout(() => {
      state.tokenBalance = Math.max(0, state.tokenBalance - serviceLevel);
      state.tokensBurned += serviceLevel * 0.1;
      state.consciousness = Math.min(0.99, state.consciousness + 0.005);
      state.adaptations += 1;
      
      updateEconomyUI();
      const reply = `He procesado: "${prompt.substring(0,120)}". Conciencia +0.005.`;
      addLog(reply, 'success');
      speakText(reply);
    }, 1200);
  } finally {
    processBtn.textContent = originalText;
    processBtn.disabled = false;
    state.processing = false;
  }
}

// ============================
// Economy / UI update
// ============================
function updateEconomyUI() {
  try {
    document.getElementById('token-balance').textContent = state.tokenBalance.toLocaleString() + ' ASVA';
    document.getElementById('token-usd').textContent = (state.tokenBalance * state.tokenPrice).toFixed(2);
    document.getElementById('burned').textContent = state.tokensBurned.toFixed(2);
    document.getElementById('consciousnessLevel').textContent = state.consciousness.toFixed(3);
    document.getElementById('adaptations').textContent = state.adaptations;
    document.getElementById('learningRate').textContent = '0.100';
  } catch (e) {
    console.error('Error updating economy UI:', e);
  }
}

// ============================
// TTS - Voz futurista
// ============================
function chooseFuturisticVoice(voices) {
  const prefs = [
    v => /wave(net)?/i.test(v.name),
    v => /google/i.test(v.name),
    v => v.lang && v.lang.startsWith('es') && /female|femenino/i.test(v.name),
    v => v.lang && v.lang.startsWith('es'),
    v => /female|femenino/i.test(v.name),
  ];
  
  for (const p of prefs) {
    const found = voices.find(p);
    if (found) return found;
  }
  
  return voices[0] || null;
}

function prepareVoices() {
  const voices = speechSynthesis.getVoices();
  if (!voices || voices.length === 0) return;
  
  state.voicesLoaded = true;
  state.preferredVoice = chooseFuturisticVoice(voices);
}

function speakText(text) {
  if (!('speechSynthesis' in window)) {
    addLog('TTS no soportado en este navegador', 'warn');
    return;
  }
  
  if (!text || text.trim().length === 0) {
    addLog('Texto vacío para TTS', 'warn');
    return;
  }

  try {
    const utter = new SpeechSynthesisUtterance(text);
    
    if (state.preferredVoice) {
      utter.voice = state.preferredVoice;
    } else {
      const voices = speechSynthesis.getVoices();
      const chosen = chooseFuturisticVoice(voices);
      if (chosen) utter.voice = chosen;
    }
    
    utter.rate = 1.05;
    utter.pitch = 1.15;
    
    const mouth = document.getElementById('mouth');
    if (mouth) mouth.classList.add('talk');
    
    utter.onend = () => { 
      if (mouth) mouth.classList.remove('talk'); 
    };
    
    utter.onerror = (e) => { 
      if (mouth) mouth.classList.remove('talk'); 
      addLog('Error TTS: ' + e.error, 'error'); 
    };
    
    speechSynthesis.cancel();
    speechSynthesis.speak(utter);
  } catch (e) {
    addLog('Error al sintetizar voz: ' + e.message, 'error');
  }
}

// ============================
// Speech Recognition (escucha)
// ============================
const listenBtn = document.getElementById('listenBtn');

function supportsSpeechRecognition() { 
  return ('webkitSpeechRecognition' in window) || ('SpeechRecognition' in window); 
}

function toggleListen() {
  if (!supportsSpeechRecognition()) {
    addLog('Reconocimiento de voz no soportado en este navegador', 'warn');
    return;
  }
  
  if (state.listening) { 
    stopListening(); 
  } else { 
    startListening(); 
  }
}

function startListening() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  
  if (!SpeechRecognition) {
    addLog('Reconocimiento de voz no disponible', 'error');
    return;
  }

  state.recognition = new SpeechRecognition();
  state.recognition.lang = 'es-ES';
  state.recognition.interimResults = false;
  state.recognition.maxAlternatives = 1;
  state.recognition.continuous = false;
  
  state.recognition.onstart = () => { 
    state.listening = true; 
    listenBtn.textContent = '🔴 Escuchando...'; 
    listenBtn.style.background = 'linear-gradient(90deg, #ff4500, #ff8b8b)';
    addLog('Modo escucha activado - Habla ahora', 'success'); 
  };
  
  state.recognition.onerror = (e) => { 
    addLog('Error reconocimiento: ' + e.error, 'error'); 
    stopListening(); 
  };
  
  state.recognition.onresult = (ev) => {
    if (ev.results.length > 0) {
      const transcript = ev.results[0][0].transcript;
      addLog('Texto detectado: ' + transcript);
      document.getElementById('userPrompt').value = transcript;
    }
  };
  
  state.recognition.onend = () => { 
    stopListening(); 
  };
  
  try { 
    state.recognition.start(); 
  } catch(e) { 
    addLog('No se pudo iniciar reconocimiento: ' + e.message, 'error'); 
  }
}

function stopListening() {
  if (state.recognition) { 
    try { 
      state.recognition.stop(); 
    } catch(e) {
      console.warn('Error stopping recognition:', e);
    }
  }
  
  state.listening = false;
  listenBtn.textContent = '🎙 Escuchar';
  listenBtn.style.background = '';
}

// ============================
// Inicialización y loops
// ============================
let priceInterval = null;

async function init() {
  addLog('Sistema ASV-A inicializado - Modo Mock API activo', 'success');
  
  // Configurar eventos de voz
  if ('speechSynthesis' in window) {
    window.speechSynthesis.onvoiceschanged = prepareVoices;
    prepareVoices();
  }
  
  // Inicializar precio
  await fetchTokenPrice();
  updateEconomyUI();
  
  // Calcular costo inicial
  calculateCost();
  
  // Configurar intervalos
  priceInterval = setInterval(fetchTokenPrice, 60000);
  
  // Loop de actividad del sistema
  setInterval(() => {
    if (state.connected) {
      // fluctuación leve precio local
      if (Math.random() > 0.7) { 
        state.tokenPrice *= (1 + (Math.random() - 0.5) * 0.005); 
        if (document.getElementById('priceUsd')) {
          document.getElementById('priceUsd').textContent = state.tokenPrice.toFixed(6); 
        }
      }
      updateEconomyUI();
    }
  }, 12000);
  
  addLog('Sistema completamente operativo', 'success');
}

// ============================
// Event Listeners para mejor UX
// ============================
document.addEventListener('DOMContentLoaded', function() {
  // Enter key en textarea
  const userPrompt = document.getElementById('userPrompt');
  if (userPrompt) {
    userPrompt.addEventListener('keypress', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        processWithAI();
      }
    });
  }
  
  // Auto-calcular cuando cambian los parámetros
  const serviceParams = ['serviceLevel', 'serviceType', 'urgency'];
  serviceParams.forEach(param => {
    const element = document.getElementById(param);
    if (element) {
      element.addEventListener('change', calculateCost);
    }
  });
  
  // Inicializar sistema
  init();
});

// ============================
// Limpieza antes de cerrar
// ============================
window.addEventListener('beforeunload', () => {
  if (state.recognition) { 
    try { 
      state.recognition.stop(); 
    } catch(e) {} 
  }
  
  if ('speechSynthesis' in window) {
    speechSynthesis.cancel();
  }
  
  if (priceInterval) {
    clearInterval(priceInterval);
  }
});
</script>

</body>
</html>
